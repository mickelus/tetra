{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/json/item_effects/outcomes/apply_effect.schema.json",
    "title": "Apply effect item effect outcome",
    "description": "Applies a mob (potion) effect on the provided entity. ",
    "examples": [
        {
            "type": "tetra:apply_effect",
            "effect": "minecraft:regeneration",
            "entity": "killer",
            "source": "killer",
            "duration": 40,
            "amplifier": 1,
            "stackDurationCap": 200
        }
    ],
    "type": "object",
    "properties": {
        "type": {
            "const": "tetra:apply_effect"
        },
        "effect": {
            "$ref": "../../resource_location.schema.json"
        },
        "entity": {
            "$ref": "../entity_providers/ref.schema.json"
        },
        "source": {
            "$ref": "../entity_providers/ref.schema.json"
        },
        "duration": {
            "$ref": "../number_providers/ref.schema.json"
        },
        "amplifier": {
            "$ref": "../number_providers/ref.schema.json"
        },
        "stackDurationCap": {
            "$ref": "../number_providers/ref.schema.json",
            "$comment": "If provided, when this outcome is triggered and 'entity' already has the mob effect active then the effect duration will be increased by 'duration' amount up to this cap."
        },
        "stackAmplifierCap": {
            "$ref": "../number_providers/ref.schema.json",
            "$comment": "If provided, when this outcome is triggered and 'entity' already has the mob effect active then the effect amplifier will be increased by 'amplifier' amount up to this cap."
        }
    },
    "required": [ "effect", "entity", "duration", "amplifier" ]
}
