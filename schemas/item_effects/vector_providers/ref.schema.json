{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/json/item_effects/vector_providers/ref.schema.json",
    "title": "Vector provider",
    "description": "Provides vectors for item effects",
    "oneOf": [
        {
            "$ref": "shorthands.schema.json"
        },
        {
            "properties": {
                "type": {
                    "const": "tetra:entity"
                },
                "entity": {
                    "$ref": "../entity_providers/ref.schema.json"
                }
            },
            "required": [ "entity" ]
        },
        {
            "properties": {
                "type": {
                    "const": "tetra:expression"
                },
                "values": {
                    "type": "object",
                    "properties": {
                        "*": { "$ref": "ref.schema.json" }
                    }
                },
                "result": { "$ref": "ref.schema.json" }
            },
            "required": [ "key" ]
        }
    ]
}
