{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/item_effects/vector_providers/entity_motion.schema.json",
    "title": "Entity motion vector provider",
    "description": "Provides the motion vector of the given entity.",
    "examples": [
        {
            "type": "tetra:entity_motion",
            "entity": "target"
        }
    ],
    "type": "object",
    "properties": {
        "type": {
            "const": "tetra:entity_motion"
        },
        "entity": {
            "$ref": "../entity_providers/ref.schema.json",
            "$comment": "The entity to get the motion of."
        }
    },
    "required": [ "entity" ]
}
