{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/json/item_effects/item_effect.schema.json",
    "title": "Item effect",
    "description": "A datadriven item effect",
    "type": "object",
    "properties": {
        "trigger": {
            "type": "string"
        },
        "effect": {
            "type": "string"
        },
        "data": {
            "type": "object",
            "properties": {
                "numbers": {
                    "type": "object",
                    "patternProperties": {
                        ".*": { "$ref": "number_providers/ref.schema.json" }
                    }
                },
                "vectors": {
                    "type": "object",
                    "patternProperties": {
                        ".*": { "$ref": "vector_providers/ref.schema.json" }
                    }
                },
                "entities": {
                    "type": "object",
                    "patternProperties": {
                        ".*": { "$ref": "entity_providers/ref.schema.json" }
                    }
                }
            }
        },
        "condition": {
            "$ref": "conditions/ref.schema.json"
        },
        "outcome": {
            "$ref": "outcomes/ref.schema.json"
        }
    },
    "required": [ "trigger", "effect", "outcome" ]
}
