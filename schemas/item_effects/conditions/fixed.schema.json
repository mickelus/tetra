{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/item_effects/conditions/fixed.schema.json",
    "title": "Fixed item effect condition",
    "description": "Either always passes or always fails.",
    "examples": [
        {
            "type": "tetra:fixed",
            "value": true
        }
    ],
    "type": "object",
    "properties": {
        "type": {
            "const": "tetra:fixed"
        },
        "value": {
            "type": "boolean",
            "$comment": "The condition passes if this is set to true."
        }
    },
    "required": [ "type", "value" ]
}
