{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/item_effects/conditions/not.schema.json",
    "title": "Not item effect condition",
    "description": "Passes if the given condition does NOT pass.",
    "examples": [
        {
            "type": "tetra:not",
            "condition": { "type": "tetra:fixed", "value": false }
        }
    ],
    "type": "object",
    "properties": {
        "type": {
            "const": "tetra:not"
        },
        "condition": {
            "$ref": "ref.schema.json",
            "$comment": "The parent condition passes if this condition does not."
        }
    },
    "required": [ "type", "condition" ]
}
