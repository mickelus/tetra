{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/stats/tooltip.schema.json",
    "title": "Tooltip",
    "description": "A tooltip representation",
    "type": "object",
    "properties": {
        "type": {
            "type": "string"
        },
        "key": {
            "type": "string"
        },
        "stats": {
            "type": "array",
            "items": {
                "$ref": "stat_getter.schema.json"
            }
        },
        "formatters": {
            "type": "array",
            "items": {
                "$ref": "stat_formatter.schema.json"
            }
        }
    },
    "required": [ "type", "key", "stats", "formatters" ]
}
