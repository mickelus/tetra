{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/modules/variant_material.schema.json",
    "title": "Flat model definition",
    "description": "Flat models are like standard vanilla item models (extruded from textures), several of these are then composed to form the model of most items.",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "default": "item",
            "description": "For bows this usually determines when a model should be included as the bow is being drawn, where a value of \"draw_0\", \"draw_1\", \"draw_2\" would determine which draw stage the model would show during and \"static\" would cause the model to show regardless of draw stage. For shields this field is a resource location referencing a model geometry resource relative \"assets/<namespace>/models/modular/shield/\". Default: \"item\".",
            "examples": [ "item", "static", "draw_0", "draw_1", "draw_2", "tetra:plate/tower" ]
        },
        "location": {
            "$ref": "../resource_location.schema.json",
            "$comment": "References a texture relative \"assets/<namespace>/textures/\". Material based module variants typically affix this based on the material and what's available in its \"availableTextures\" array.",
            "examples": [ "tetra:item/module/shield/plate/tower/", "tetra:item/module/toolbelt/belt/inlaid" ]
        },
        "renderType": {
            "$ref": "../resource_location.schema.json",
            "$comment": "Allows for a different render type to be used when rendering the model. Default: \"minecraft:solid\".",
            "default": "minecraft:solid"
        },
        "transform": {
            "type": "object",
            "description": "Allows for the model to be scaled, translated and/or rotated.",
            "properties": {
                "translation": {
                    "type": "array",
                    "items": { "type": "number" }
                },
                "leftRotation": {
                    "type": "array",
                    "items": { "type": "number" }
                },
                "scale": {
                    "type": "array",
                    "items": { "type": "number" }
                },
                "rightRotation": {
                    "type": "array",
                    "items": { "type": "number" }
                }
            }
        },
        "emission": {
            "type": "number",
            "default": 0
        },
        "tint": {
            "$ref": "../hexadecimal.schema.json",
            "default": "ffffffff"
        },
        "overlayTint": {
            "$ref": "../hexadecimal.schema.json",
            "default": "ffffffff"
        },
        "renderLayer": {
            "type": "string",
            "enum": [ "LOWEST", "LOWER", "LOW", "BASE", "HIGH", "HIGHER", "HIGHEST" ],
            "default": "BASE"
        },
        "perspectives": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "none",
                    "thirdperson_lefthand",
                    "thirdperson_righthand",
                    "firstperson_lefthand",
                    "firstperson_righthand",
                    "head",
                    "gui",
                    "ground",
                    "fixed"
                ]
            }
        },
        "invertPerspectives": {
            "type": "boolean",
            "default": false
        }
    },
    "required": [ "location" ]
}
