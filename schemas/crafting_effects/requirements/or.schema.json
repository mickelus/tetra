{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tetra.mickelus.se/schemas/1.20/crafting_effects/requirements/or.schema.json",
    "title": "Or crafting requirement",
    "description": "Passes if ANY of the given requirements pass.",
    "examples": [
        {
            "type": "tetra:or",
            "requirements": [
                { "type": "tetra:never" },
                { "type": "tetra:never" }
            ]
        }
    ],
    "type": "object",
    "properties": {
        "type": {
            "const": "tetra:or"
        },
        "requirements": {
            "type": "array",
            "items": { "$ref": "ref.schema.json" },
            "$comment": "At least one requirement in this array must pass for this requirement to pass."
        }
    },
    "required": [ "type", "requirements" ]
}
